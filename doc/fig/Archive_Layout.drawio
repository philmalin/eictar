<mxfile host="Electron">
  <diagram name="Archive layout" id="archive_layout">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- The start and the end of the file -->
        <mxCell id="t_offset" value="offset 0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=bottom;rounded=0;fontFamily=Helvetica;fontSize=10;fontColor=#4D4D4D;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="t_eof" value="EOF" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontFamily=Helvetica;fontSize=10;fontColor=#4D4D4D;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="80" height="20" as="geometry" />
        </mxCell>
        <!-- The regions, in file order. Grey dashed: present only in some archives -->
        <mxCell id="header" value="File header&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;64 bytes, fixed&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;strokeColor=#000000;strokeWidth=0.75;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#000000;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="crypto" value="Crypto header&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;if encrypted; its length is in the file header&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;strokeColor=#666666;strokeWidth=0.75;dashed=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#000000;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dict" value="Dictionary blob (§4.2), if any" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;strokeColor=#666666;strokeWidth=0.75;dashed=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#000000;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m0" value="Member blob 0" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;strokeColor=#000000;strokeWidth=0.75;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#000000;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="Member blob 1" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;strokeColor=#000000;strokeWidth=0.75;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#000000;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="more" value="…" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;strokeColor=#000000;strokeWidth=0.75;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#000000;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dead" value="Dead space: old indexes, tombstoned blobs" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;strokeColor=#666666;strokeWidth=0.75;dashed=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#000000;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mn" value="Member blob N" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;strokeColor=#000000;strokeWidth=0.75;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#000000;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="index" value="Index blob&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;CBOR → zstd → [AEAD]&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;strokeColor=#000000;strokeWidth=0.75;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#000000;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="trailer" value="Trailer&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;96 bytes, fixed&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;strokeColor=#000000;strokeWidth=0.75;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#000000;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="400" height="40" as="geometry" />
        </mxCell>
        <!-- The body: from the first blob to the last -->
        <mxCell id="body_brace" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;strokeColor=#000000;strokeWidth=0.75;fillColor=none;size=0.5;" vertex="1" parent="1">
          <mxGeometry x="450" y="120" width="20" height="180" as="geometry" />
        </mxCell>
        <mxCell id="t_body" value="body" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="480" y="200" width="50" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
